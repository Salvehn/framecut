; Generated by scripts/prepare-installer.cjs. Per-user registration; defaults remain user-controlled.
LangString FramecutOpen 1033 "Open in Framecut"
LangString FramecutOpen 1049 "Открыть в Framecut"
LangString FramecutOpen 1031 "In Framecut öffnen"
LangString FramecutOpen 3082 "Abrir en Framecut"
!macro customInstall
  WriteRegStr HKCU "Software\Classes\Framecut.Video" "" "Framecut video"
